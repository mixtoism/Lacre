# Nodo p2message siempre encendido (relay, buzones, servicio onion).
#
#   sudo useradd --system --home-dir /var/lib/p2m-node p2m
#   sudo install -m755 target/release/p2m-node /usr/local/bin/
#   sudo cp deploy/p2m-node.service /etc/systemd/system/
#   sudo systemctl enable --now p2m-node
#
# Con IP pública, abre el puerto 4001 (TCP y UDP) y deja `--relay-server`.
# Tras NAT o CGNAT quita `--relay-server`: el nodo sigue siendo útil como
# buzón y como punto de entrada por su servicio onion. La dirección, lista
# para usar como `--bootstrap`, sale en el journal:
#   journalctl -u p2m-node | grep 'escuchando en /onion3'
[Unit]
Description=p2message node
After=network-online.target
Wants=network-online.target

[Service]
User=p2m
StateDirectory=p2m-node
ExecStart=/usr/local/bin/p2m-node --headless --data /var/lib/p2m-node --port 4001 --relay-server
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
